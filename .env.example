# Database (external PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/smart_prescription"

# JWT Auth
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
CORS_ORIGIN="*"

# PPB Drug Catalog (DHA HIE Terminology Service)
PPB_TOKEN_URL="https://accounts.dha.go.ke/realms/hie/protocol/openid-connect/token"
PPB_CLIENT_ID=""
PPB_CLIENT_SECRET=""
PPB_CATALOG_URL="https://ilm-hie.dha.go.ke/adapter/facade/hie/api/v1/terminology-service"
PPB_PAGE_SIZE=500

# ICD-11 Search
ICD_BASE_URL="https://icd.tiberbu.health/icd/release/11/2025-01/mms"
